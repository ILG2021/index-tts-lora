+void IndexTTS2GptRuntime::activate_lora(const std::string & name, float scale_value) {
+    if (!std::isfinite(scale_value)) {
+        throw std::runtime_error("IndexTTS2 LoRA scale must be finite");
+    }
+    std::shared_ptr<const IndexTTS2GptLoraAdapter> selected;
+    if (!name.empty() && name != "base" && name != "none") {
+        const auto it = lora_adapters_.find(name);
+        if (it == lora_adapters_.end()) throw std::runtime_error("unknown IndexTTS2 LoRA: " + name);
+        selected = it->second;
+    }
+    const std::string normalized = selected == nullptr ? std::string{} : name;
+    if (normalized == active_lora_name_ && scale_value == active_lora_scale_) return;
+    active_lora_ = std::move(selected);
+    active_lora_name_ = normalized;
+    active_lora_scale_ = scale_value;
+    release_generation_graphs();
+    engine::debug::log_message(engine::debug::LogLevel::Info, "index_tts2",
+        active_lora_ == nullptr ? "runtime LoRA disabled" :
+        "runtime LoRA switched to " + active_lora_name_ + ", scale=" + std::to_string(active_lora_scale_));
+}
+
+std::vector<std::string> IndexTTS2GptRuntime::lora_names() const {
+    std::vector<std::string> out;
+    out.reserve(lora_adapters_.size());
+    for (const auto & [name, _] : lora_adapters_) out.push_back(name);
+    std::sort(out.begin(), out.end());
+    return out;
+}
