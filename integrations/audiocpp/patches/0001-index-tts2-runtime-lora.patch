+std::shared_ptr<const IndexTTS2GptLoraAdapter> load_index_tts2_gpt_lora(
+    const std::filesystem::path & path,
+    core::ExecutionContext & execution) {
+    if (path.extension() != ".safetensors") {
+        throw std::runtime_error("IndexTTS2 runtime LoRA must be an unfused .safetensors adapter: " + path.string());
+    }
+    const auto source = engine::assets::open_tensor_source(path);
+    auto adapter = std::make_shared<IndexTTS2GptLoraAdapter>();
+    adapter->store = std::make_shared<core::BackendWeightStore>(
+        execution.backend(), execution.backend_type(), "index_tts2.gpt.lora", 8ull * 1024ull * 1024ull);
+    adapter->layers.resize(kGptLayers);
+    std::unordered_set<std::string> consumed;
+    size_t projection_count = 0;
+
+    const auto load_projection = [&](int64_t layer, const char * suffix, int64_t in_features, int64_t out_features)
+        -> std::optional<IndexTTS2GptLoraProjection> {
+        const std::string prefix = "gpt.h." + std::to_string(layer) + "." + suffix;
+        const std::string a_name = prefix + ".lora_A";
+        const std::string b_name = prefix + ".lora_B";
+        const bool has_a = source->has_tensor(a_name);
+        const bool has_b = source->has_tensor(b_name);
+        if (!has_a && !has_b) return std::nullopt;
+        if (!has_a || !has_b) {
+            throw std::runtime_error("IndexTTS2 LoRA is missing an A/B pair: " + prefix);
+        }
+        const auto a_meta = source->require_metadata(a_name);
+        const auto b_meta = source->require_metadata(b_name);
+        if (a_meta.shape.size() != 2 || b_meta.shape.size() != 2) {
+            throw std::runtime_error("IndexTTS2 LoRA tensors must be rank-2: " + prefix);
+        }
+        const int64_t rank = a_meta.shape[0];
+        if (rank <= 0 || a_meta.shape[1] != in_features ||
+            b_meta.shape[0] != out_features || b_meta.shape[1] != rank) {
+            throw std::runtime_error("IndexTTS2 LoRA shape mismatch: " + prefix);
+        }
+        IndexTTS2GptLoraProjection out;
+        out.a = {adapter->store->load_tensor(
+            *source, a_name, engine::assets::TensorStorageType::F16, {rank, in_features}), std::nullopt};
+        out.b = {adapter->store->load_tensor(
+            *source, b_name, engine::assets::TensorStorageType::F16, {out_features, rank}), std::nullopt};
+        consumed.insert(a_name);
+        consumed.insert(b_name);
+        ++projection_count;
+        return out;
+    };
+
+    for (int64_t layer = 0; layer < kGptLayers; ++layer) {
+        auto & target = adapter->layers[static_cast<size_t>(layer)];
+        target.qkv = load_projection(layer, "attn.c_attn", kModelDim, 3 * kModelDim);
+        target.attn_out = load_projection(layer, "attn.c_proj", kModelDim, kModelDim);
+        target.mlp_in = load_projection(layer, "mlp.c_fc", kModelDim, kGptMlpDim);
+        target.mlp_out = load_projection(layer, "mlp.c_proj", kGptMlpDim, kModelDim);
+    }
+    for (const auto & tensor : source->tensors()) {
+        if (!consumed.count(tensor.name)) {
+            throw std::runtime_error("Unsupported IndexTTS2 runtime LoRA tensor: " + tensor.name);
+        }
+    }
+    if (projection_count == 0) {
+        throw std::runtime_error("IndexTTS2 runtime LoRA contains no GPT-2 projection pairs");
+    }
+    adapter->store->upload();
+    source->release_storage();
+    engine::debug::log_message(engine::debug::LogLevel::Info, "index_tts2",
+        "loaded runtime LoRA " + path.string() + ", projections=" + std::to_string(projection_count));
+    return adapter;
+}
